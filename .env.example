# Copy this file to .env and fill it in. Never commit .env.

# --- Interpreter (spec section 4a) ---
# api = Anthropic API (default, used for the demo). cli = Claude Code CLI (development only).
INTERPRETER=api
ANTHROPIC_API_KEY=
# A fast model. Set a monthly spend limit on the key in the Anthropic Console.
CLAUDE_MODEL=claude-haiku-5-5
# Model alias for the CLI adapter (development only)
CLAUDE_CLI_MODEL=haiku

# --- Speech to text ---
# faster-whisper runs on this server (CPU). The model downloads on first use.
STT_PROVIDER=faster-whisper
# base.en: about 1 s per sentence. small.en: about 3 s, better in noise. small: other languages.
STT_MODEL=base.en
STT_LANGUAGE=en

# --- Server ---
DATA_DIR=data
# Comma-separated origins, or * (the WebView origin is not documented)
CORS_ALLOW_ORIGINS=*
# Public base URL of this backend, shown on the glasses for the phone page
PUBLIC_BASE_URL=http://localhost:8000

# --- Google Drive (server side only, optional) ---
# Leave GOOGLE_DRIVE_FOLDER_ID empty to switch the upload off.
# One-time setup: python -m tools.drive_auth  (it prints the folder id). See README.
GOOGLE_DRIVE_FOLDER_ID=
# OAuth client file from the Google Cloud Console (type: Desktop app). Keep it out of git.
GOOGLE_OAUTH_CLIENT_FILE=data/google_client.json
# Written by tools/drive_auth.py. Keep it out of git.
GOOGLE_TOKEN_FILE=data/google_token.json
